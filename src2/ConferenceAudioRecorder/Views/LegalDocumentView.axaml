<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConferenceAudioRecorder.Localization"
             xmlns:legal="clr-namespace:ConferenceAudioRecorder.Legal"
             x:Class="ConferenceAudioRecorder.Views.LegalDocumentView"
             Margin="16">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="TitleBlock" FontSize="20" FontWeight="Bold" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,12">
            <TextBlock Text="{loc:Loc DocumentLanguage}" />
            <ComboBox x:Name="LanguageBox"
                      MinWidth="240"
                      HorizontalAlignment="Left"
                      SelectionChanged="OnLanguageChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="legal:DocumentLanguage">
                        <TextBlock Text="{Binding NativeName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DocumentHost" />
        </ScrollViewer>
        <Button Grid.Row="3"
                Content="{loc:Loc Close}"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Click="OnClose" />
    </Grid>
</UserControl>
