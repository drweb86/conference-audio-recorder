<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConferenceAudioRecorder.Localization"
        xmlns:icons="clr-namespace:ConferenceAudioRecorder"
        x:Class="ConferenceAudioRecorder.MainWindow"
        Width="680"
        Height="420"
        MinWidth="560"
        MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="Auto,*">
        <Border x:Name="NavPane"
                Grid.Column="0"
                Classes="collapsed"
                Width="56"
                ClipToBounds="True"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource ButtonBorderBrush}"
                Padding="8">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.16" />
                </Transitions>
            </Border.Transitions>
            <DockPanel>
                <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <RadioButton x:Name="SettingsNav"
                                 Grid.Row="0"
                                 Classes="nav compact"
                                 GroupName="pages"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 ToolTip.Tip="{loc:Loc Settings}"
                                 Click="OnShowSettings">
                        <StackPanel x:Name="SettingsItem" Orientation="Horizontal" HorizontalAlignment="Center">
                            <PathIcon Data="{x:Static icons:AppIcons.Settings}" Width="16" Height="16" />
                            <TextBlock x:Name="SettingsLabel"
                                       Margin="8,0,0,0"
                                       Text="{loc:Loc Settings}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="False"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AboutNav"
                                 Grid.Row="1"
                                 Classes="nav compact"
                                 GroupName="pages"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 ToolTip.Tip="{loc:Loc TheApplicationView}"
                                 Click="OnShowAbout">
                        <StackPanel x:Name="AboutItem" Orientation="Horizontal" HorizontalAlignment="Center">
                            <PathIcon Data="{x:Static icons:AppIcons.Info}" Width="16" Height="16" />
                            <TextBlock x:Name="AboutLabel"
                                       Margin="8,0,0,0"
                                       Text="{loc:Loc TheApplicationView}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="False"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                    <Button x:Name="NavToggle"
                            Grid.Row="0"
                            Classes="navtoggle compact"
                            HorizontalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            Click="OnToggleNav">
                        <PathIcon x:Name="NavToggleIcon"
                                  Data="{x:Static icons:AppIcons.ChevronRight}"
                                  Width="16"
                                  Height="16" />
                    </Button>
                    <RadioButton x:Name="RecordingNav"
                                 Grid.Row="1"
                                 Classes="nav compact"
                                 GroupName="pages"
                                 IsChecked="True"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 ToolTip.Tip="{loc:Loc Recording}"
                                 Click="OnShowRecording">
                        <StackPanel x:Name="RecordingItem" Orientation="Horizontal" HorizontalAlignment="Center">
                            <PathIcon Data="{x:Static icons:AppIcons.Record}" Width="16" Height="16" />
                            <TextBlock x:Name="RecordingLabel"
                                       Margin="8,0,0,0"
                                       Text="{loc:Loc Recording}"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="False"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </DockPanel>
        </Border>
        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
