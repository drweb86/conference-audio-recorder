<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>ConferenceAudioRecorder</RootNamespace>
    <AssemblyName>ConferenceAudioRecorder</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2026.9.26</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NAudio.Alsa" Version="3.1.0" />
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="NLog" Version="6.0.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\licenses\*.md" Exclude="..\..\licenses\README.md" LogicalName="ConferenceAudioRecorder.License.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\privacy\desktop\*.md" Exclude="..\..\privacy\desktop\README.md" LogicalName="ConferenceAudioRecorder.Privacy.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\notices\*.md" Exclude="..\..\notices\README.md" LogicalName="ConferenceAudioRecorder.Notices.%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <RespectAlreadyAssignedItemCulture>true</RespectAlreadyAssignedItemCulture>
  </PropertyGroup>

  <Target Name="AssignLocalizationCultures" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <EmbeddedResource Condition="'%(Extension)' == '.resx' and $([System.String]::Copy('%(Filename)').StartsWith('Strings.'))">
        <Culture>$([System.String]::Copy('%(Filename)').Substring(8))</Culture>
        <WithCulture>true</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
</Project>
